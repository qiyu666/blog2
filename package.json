{
  "name": "blog2",
  "scripts": {
    "dev": "vite",
    "dev:functions": "npm run build && npx wrangler pages dev ./dist",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy ./dist",
    "db:create": "npx wrangler d1 create blog-db",
    "db:init": "npx wrangler d1 execute blog-db --file=./schema.sql",
    "db:init:remote": "npx wrangler d1 execute blog-db --remote --file=./schema-v17.sql",
    "db:migrate": "npx wrangler d1 execute blog-db --file=./schema-v17.sql",
    "db:migrate:remote": "npx wrangler d1 execute blog-db --remote --file=./schema-v17.sql"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/prismjs": "^1.26.6",
    "dompurify": "^3.4.12",
    "i18next": "^26.3.6",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "playwright": "^1.62.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wrangler": "^3.78.0"
  }
}
