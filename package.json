{
  "name": "blog2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && npx wrangler pages deploy ./dist --project-name=blog2",
    "db:create": "npx wrangler d1 create blog-db",
    "db:init": "npx wrangler d1 execute blog-db --file=./schema.sql",
    "db:init:remote": "npx wrangler d1 execute blog-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "wrangler": "^3.78.0"
  }
}
